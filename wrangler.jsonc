// Cloudflare Workers static assets: serves the built site (dist/) on bwithu.live.
// Deploy: npm run deploy
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bwithu-website",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  // Custom domains: Cloudflare creates their DNS records. app.bwithu.live (the call app) is a separate record.
  "routes": [
    { "pattern": "bwithu.live", "custom_domain": true },
    { "pattern": "www.bwithu.live", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
